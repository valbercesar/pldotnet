        // needed for string conversion
        static UTF8Encoding utf8_e = new UTF8Encoding();

        [DllImport("@PKG_LIBDIR/pldotnet.so")]
        public static extern unsafe void pldotnet_getDatumTextAttributes(IntPtr datum, int* len, byte** buf);

        public static unsafe String pldotnet_BuildString(IntPtr datum)
        {
            int strlen;
            byte* str_p;

            pldotnet_getDatumTextAttributes(datum, &strlen, &str_p);
            ReadOnlySpan<byte> nativeSpan = new ReadOnlySpan<byte>(str_p, strlen);
            String s1 = utf8_e.GetString(nativeSpan.ToArray(), 0, strlen);
            return s1;
        }

        [DllImport("@PKG_LIBDIR/pldotnet.so")]
        public static extern void pldotnet_getDatumDateAttributes(IntPtr datum, ref int date);

        public static DateOnly pldotnet_BuildDate(IntPtr datum)
        {
            int date = 0;
            pldotnet_getDatumDateAttributes(datum, ref date);
            return date switch
            {
                int.MaxValue => DisableDateTimeInfinityConversions ?
                    throw new InvalidCastException(InfinityExceptionMessage) : DateOnly.MaxValue,
                int.MinValue => DisableDateTimeInfinityConversions ?
                    throw new InvalidCastException(InfinityExceptionMessage) : DateOnly.MinValue,
                var value => DateOnly.FromDayNumber(value + 730119)
            };
        }

        [DllImport("@PKG_LIBDIR/pldotnet.so")]
        public static extern void pldotnet_getDatumTimeAttributes(IntPtr datum, ref long time);

        public static TimeOnly pldotnet_BuildTime(IntPtr datum)
        {
            long time = 0;
            pldotnet_getDatumTimeAttributes(datum, ref time);
            return new TimeOnly(time*10);
        }

        [DllImport("@PKG_LIBDIR/pldotnet.so")]
        public static extern void pldotnet_getDatumTimeTzAttributes(IntPtr datum, ref long time, ref int zone);

        public static DateTimeOffset pldotnet_BuildTimeTz(IntPtr datum)
        {
            long time = 0;
            int zone = 0;
            pldotnet_getDatumTimeTzAttributes(datum, ref time, ref zone);
            return new DateTimeOffset(time*10 + TimeSpan.TicksPerDay, new TimeSpan(0, 0, -zone));
        }

        [DllImport("@PKG_LIBDIR/pldotnet.so")]
        public static extern void pldotnet_getDatumTimestampAttributes(IntPtr datum, ref long timestamp);

        static readonly long PostgresTimestampOffsetTicks = 630822816000000000L;
        public static DateTime createDateTimeObject(long timestamp, DateTimeKind kind)
        {
            try
            {
                return timestamp switch
                {
                    long.MaxValue => DisableDateTimeInfinityConversions ? throw new InvalidCastException(InfinityExceptionMessage) : DateTime.MaxValue,
                    long.MinValue => DisableDateTimeInfinityConversions ? throw new InvalidCastException(InfinityExceptionMessage) : DateTime.MinValue,
                    var value => new DateTime(value * 10 + PostgresTimestampOffsetTicks, kind)
                };
            }
            catch (ArgumentOutOfRangeException e)
            {
                throw new InvalidCastException("Out of the range of DateTime (year must be between 1 and 9999)", e);
            }
        }

        public static DateTime pldotnet_BuildTimestamp(IntPtr datum)
        {
            long timestamp = 0;
            pldotnet_getDatumTimestampAttributes(datum, ref timestamp);
            return createDateTimeObject(timestamp, DateTimeKind.Unspecified);
        }

        [DllImport("@PKG_LIBDIR/pldotnet.so")]
        public static extern void pldotnet_getDatumTimestampTzAttributes(IntPtr datum, ref long timestamp);

        public static DateTime pldotnet_BuildTimestampTz(IntPtr datum)
        {
            long timestamp = 0;
            pldotnet_getDatumTimestampTzAttributes(datum, ref timestamp);
            DateTime dateTime = createDateTimeObject(timestamp, DateTimeKind.Utc);
            return LegacyTimestampBehavior && (DisableDateTimeInfinityConversions || dateTime != DateTime.MaxValue && dateTime != DateTime.MinValue)
            ? dateTime.ToLocalTime()
            : dateTime;
        }

