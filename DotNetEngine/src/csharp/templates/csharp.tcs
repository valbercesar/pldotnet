        /// <summary>
        /// Note: this function should be loaded outside Roslyn (e.g Engine.cs) and then shared here through a delegate
        /// This function is responsible for sending the current .NET result back to C
        /// This implementation is not generic for now, but it should be easy to make it generic
        /// Parameters:
        ///     - npts: the number of points
        ///     - boundbox: a pointer to a boundbox structure
        ///     - points: a pointer to a list of points
        /// Returns: a Datum representing the memory address storing the new Postgres Point
        /// </summary>
        [DllImport("@PKG_LIBDIR/pldotnet.so")]
        public static extern IntPtr pldotnet_NewPolygon(int npts, IntPtr boundbox, IntPtr[] points);

        /// HELPERS

        /// <summary>
        /// Note: this function should be loaded outside Roslyn (e.g Engine.cs) and then shared here through a delegate
        /// This function is responsible for sending the current NpgsqlPolygon back to C/Postgres
        /// Parameters:
        ///     - polygon: a NpgsqlPolygon structure
        ///     - output: the native memory to store the result
        /// </summary>
        public static void SetPolygonResult(NpgsqlPolygon polygon, IntPtr output)
        {
            if (polygon != null && 2 < polygon.Count)
            {
                var npts = polygon.Count;

                var first = polygon[0];
                var last = polygon[npts - 1];

                NpgsqlPoint lowerLeft = new NpgsqlPoint(first.X, first.Y);
                NpgsqlPoint upperRight = new NpgsqlPoint(last.X, last.Y);

                var points = new IntPtr[npts];

                for (var i = 0; i < npts; i++)
                {
                    NpgsqlPoint point = polygon[i];

                    if (point.X < lowerLeft.X)
                    {
                        lowerLeft.X = point.X;
                    }

                    if (point.Y < lowerLeft.Y)
                    {
                        lowerLeft.Y = point.Y;
                    }

                    if (point.X > upperRight.X)
                    {
                        upperRight.X = point.X;
                    }

                    if (point.Y > upperRight.Y)
                    {
                        upperRight.Y = point.Y;
                    }

                    points[i] = pldotnet_NewPoint(point.X, point.Y);
                }

                // build the boundbox points
                var pgLowerLeft = pldotnet_NewPoint(lowerLeft.X, lowerLeft.Y);
                var pgUpperRight = pldotnet_NewPoint(upperRight.X, upperRight.Y);

                // create the bounding box
                var boundbox = pldotnet_NewBox(pgUpperRight, pgLowerLeft);

                // build the polygon
                var pgPolygon = pldotnet_NewPolygon(npts, boundbox, points);

                // send the result back to Postgres
                pldotnet_SetPolygonResult(pgPolygon, false, output);
            }
            else
            {
                pldotnet_SetPolygonResult(IntPtr.Zero, true, output);
            }
        }

