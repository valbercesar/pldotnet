        [DllImport("@PKG_LIBDIR/pldotnet.so")]
        public static extern unsafe void pldotnet_getDatumInetAttributes(IntPtr datum, ref int nelem, [Out] byte[] bytes, ref int netmask);

        public static (IPAddress, int) pldotnet_BuildInet(IntPtr datum)
        {
            int nelem = 0, netmask = 0;
            byte[] bytes = new byte[16];
            pldotnet_getDatumInetAttributes(datum, ref nelem, bytes, ref netmask);
            byte[] new_bytes = new byte[nelem];
            for(int i = 0; i<nelem; i++)
            {
                new_bytes[i]=bytes[i];
            }
            return (new IPAddress(new_bytes), netmask);
        }

