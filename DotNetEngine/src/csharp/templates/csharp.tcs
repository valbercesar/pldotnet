        public static extern IntPtr pldotnet_createDatumInt32(int dotnetValue);

        [DllImport("@PKG_LIBDIR/pldotnet.so")]
        public static extern IntPtr pldotnet_createDatumInt64(long dotnetValue);

        [DllImport("@PKG_LIBDIR/pldotnet.so")]
        public static extern IntPtr pldotnet_createDatumFloat(float dotnetValue);

        [DllImport("@PKG_LIBDIR/pldotnet.so")]
        public static extern IntPtr pldotnet_createDatumDouble(double dotnetValue);

        [DllImport("@PKG_LIBDIR/pldotnet.so")]
        public static extern IntPtr pldotnet_createDatumBoolean(bool dotnetValue);

        [DllImport("@PKG_LIBDIR/pldotnet.so")]
        public static extern IntPtr pldotnet_createDatumPoint(double x, double y);
        
        /// SEND THE FINAL DATUM TO POSTGRES
        [DllImport("@PKG_LIBDIR/pldotnet.so")]
        public static extern void pldotnet_SetDatumResult(IntPtr value, bool isnull, IntPtr native_result);

