        [DllImport("@PKG_LIBDIR/pldotnet.so")]
        public static extern double pldotnet_getDouble(IntPtr datum);

        [DllImport("@PKG_LIBDIR/pldotnet.so")]
        [return: MarshalAs(UnmanagedType.I1)]
        public static extern bool pldotnet_getBoolean(IntPtr datum);

        [DllImport("@PKG_LIBDIR/pldotnet.so")]
        public static extern void pldotnet_getDatumPointAttributes(IntPtr datum, ref double x,  ref double y);

        public static NpgsqlPoint pldotnet_BuildNpgsqlPoint(IntPtr datum)
        {
            double x=0.0, y=0.0;
            pldotnet_getDatumPointAttributes(datum, ref x, ref y);
            return new NpgsqlPoint(x,y);
        }

