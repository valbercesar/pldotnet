        static readonly bool DisableDateTimeInfinityConversions = true;
        static readonly bool LegacyTimestampBehavior = true;
        static readonly string InfinityExceptionMessage =
        "Can't read infinity value since UserClass.DisableDateTimeInfinityConversions is enabled";

