        [DllImport("@PKG_LIBDIR/pldotnet.so")]
        public static extern unsafe IntPtr pldotnet_createDatumText(int len, byte* buf);

        public static unsafe IntPtr pldotnet_createDatumTextInternal(string s)
        {
            IntPtr datum;
            byte[] encodedBytes = utf8_e.GetBytes(s);
            int len = encodedBytes.Length;
            fixed (byte* buf = &encodedBytes[0])
            {
                datum = pldotnet_createDatumText(len, buf);
            }
            return datum;
        }

        [DllImport("@PKG_LIBDIR/pldotnet.so")]
        public static extern unsafe IntPtr pldotnet_createDatumPath(int npts, int closed, double *xCoordinates, double *yCoordinates);

        public static unsafe IntPtr pldotnet_createDatumPath(NpgsqlPath path)
        {
            int npts = path.Count;
            bool open = path.Open;
            int closed = open ? 0 : 1;
            double[] xCoordinates = new double[npts];
            double[] yCoordinates = new double[npts];
            for(int i = 0; i<npts;i++)
            {
                xCoordinates[i] = path[i].X;
                yCoordinates[i] = path[i].Y;
            }
            fixed (double* x = &xCoordinates[0], y = &yCoordinates[0])
			{
				return pldotnet_createDatumPath(npts, closed, x, y);
			}
        }

        [DllImport("@PKG_LIBDIR/pldotnet.so")]
        public static extern unsafe IntPtr pldotnet_createDatumPolygon(int npts, double *xCoordinates, double *yCoordinates);

        public static unsafe IntPtr pldotnet_createDatumPolygon(NpgsqlPolygon path)
        {
            int npts = path.Count;
            double[] xCoordinates = new double[npts];
            double[] yCoordinates = new double[npts];
            for(int i = 0; i<npts;i++)
            {
                xCoordinates[i] = path[i].X;
                yCoordinates[i] = path[i].Y;
            }
            fixed (double* x = &xCoordinates[0], y = &yCoordinates[0])
			{
				return pldotnet_createDatumPolygon(npts, x, y);
			}
        }

