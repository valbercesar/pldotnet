        public static NpgsqlLSeg pldotnet_BuildNpgsqlLSeg(IntPtr datum)
        {
            double x1=0.0, y1=0.0, x2=0.0, y2=0.0;
            pldotnet_getDatumLineSegmentAttributes(datum, ref x1, ref y1, ref x2, ref y2);
