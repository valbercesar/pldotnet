CREATE OR REPLACE FUNCTION get_sumFSharp(
   a NUMERIC(3,2), 
   b NUMERIC) 
RETURNS NUMERIC(4,1) AS $$
match (a, b) with
| Some _a, Some _b -> Some (_a + _b)
| _ -> None
$$
LANGUAGE plfsharp;
SELECT get_sumFSharp(1.3333333, 10) =  numeric '11.3333333';
 ?column? 
----------
 t
(1 row)

SELECT get_sumFSharp(1.33333333, -10.99999999) = '-9.66666666';
 ?column? 
----------
 t
(1 row)

SELECT get_sumFSharp(1999999999999.555555555555555, -10.99999999) = numeric '1999999999988.555555565555555'; -- 1999999999988.555555565555555
 ?column? 
----------
 t
(1 row)

CREATE OR REPLACE FUNCTION getbigNumFSharp(a NUMERIC) RETURNS NUMERIC AS $$
match a with
| None -> None
| _ -> a
$$
LANGUAGE plfsharp;
SELECT getbigNumFSharp(999999999999999999991.9999991) = numeric '999999999999999999991.9999991'; -- Sextllion at 7 scale (10 power 28 precision)
 ?column? 
----------
 t
(1 row)

SELECT getbigNumFSharp(999999999999999999991.99999999) =  numeric '999999999999999999992.0000000'; -- It is rounded to 999999999999999999992.0000000
 ?column? 
----------
 t
(1 row)

