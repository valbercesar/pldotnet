CREATE OR REPLACE FUNCTION returnUnknownNameFSharp(a varchar, b integer) RETURNS varchar AS $$
match (a, b) with
| (Some _a, Some _b) -> append_integer_to_string a b |> Some
| _ -> None
$$ LANGUAGE plfsharp;
