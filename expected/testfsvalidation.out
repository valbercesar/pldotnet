CREATE OR REPLACE FUNCTION returnValidOperationFSharp(a text, b double precision) RETURNS double precision AS $$
match (a, b) with
| (Some _a, Some _b) -> Math.Sqrt(Convert.ToDouble(_a)) + _b |> Some
| _ -> None
$$ LANGUAGE plfsharp;
