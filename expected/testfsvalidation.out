CREATE OR REPLACE FUNCTION returnInvalidOperationFSharp(a text, b double precision) RETURNS double precision AS $$
match (a, b) with
| (Some a, Some b) -> Math.Sqrt(a) + b
| _ -> -1.0
$$ LANGUAGE plfsharp;
