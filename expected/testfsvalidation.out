CREATE OR REPLACE FUNCTION returnValidReturnTypeFSharp(a integer, b integer) RETURNS text AS $$
match (a, b) with
| (Some a, Some b) ->
    let c = a + b
    Convert.ToString(c) |> Some
| _ -> None
$$ LANGUAGE plfsharp;
