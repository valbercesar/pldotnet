CREATE OR REPLACE FUNCTION sum2BigIntFSharp(a bigint, b bigint) RETURNS bigint AS $$
match (a, b) with
| Some _a, Some _b -> Some ((int64) _a + _b)
| _ -> None
$$ LANGUAGE plfsharp;
SELECT sum2BigIntFSharp(9223372036854775707, 100) = bigint '9223372036854775807';
 ?column? 
