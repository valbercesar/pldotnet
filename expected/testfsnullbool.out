CREATE OR REPLACE FUNCTION BooleanNullXorFSharp(a boolean, b boolean) RETURNS boolean AS $$
match (a, b) with
| Some _a, Some _b -> Some (_a <> _b)
| _ -> None
$$ LANGUAGE plfsharp;
