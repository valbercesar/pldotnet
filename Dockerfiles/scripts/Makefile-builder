# avoids tzdata prompt
export DEBIAN_FRONTEND=noninteractive

apt_update: 
	echo "# ENVIRONMENT SETUP: running $@"
	apt-get update 
	# install the basics
	apt install -y wget apt-transport-https build-essential apt-utils pkg-config

add_dotnet: apt_update
	echo "# ENVIRONMENT SETUP: running $@"
	wget -q \
		https://packages.microsoft.com/config/debian/10/packages-microsoft-prod.deb \
		-O packages-microsoft-prod.deb
	dpkg -i packages-microsoft-prod.deb 
	apt-get update 

install_dotnet: add_dotnet
	echo "# ENVIRONMENT SETUP: running $@"
	apt-get install -y dotnet-sdk-6.0
	apt-get install -y dotnet-runtime-6.0
	apt-get install -y dotnet-hostfxr-6.0

install_requirements: apt_update
	echo "# ENVIRONMENT SETUP: running $@"
	apt install -y wget libglib2.0-dev apt-transport-https lsb-release build-essential

install_pg_dev: install_requirements
	# installs postgresql dev packages
	echo "# ENVIRONMENT SETUP: running $@"
	apt install -y postgresql-server-dev-all lsb-release devscripts
	mkdir -p /var/log/postgresql/data1
	apt install -y postgresql postgresql-common postgresql-server-dev-all 

install_pg: install_pg_dev
	# install postgresql server for testing
	echo "# ENVIRONMENT SETUP: running $@"
	apt install -y postgresql-14

install_misc:
	# installs miscellaneous commands for convenience
	echo "# ENVIRONMENT SETUP: running $@"
	apt install -y sudo vim cdecl strace

install_cluster_requirements:
	# cluster creation requirements; locale settings
	echo "# ENVIRONMENT SETUP: running $@"
	apt install -y locales rsync
	sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen
	locale-gen

create_cluster_and_install_extension:
	# creating persistent cluster and installing extension
	echo "# ENVIRONMENT SETUP: running $@"
	bash /app/pldotnet/Dockerfiles/scripts/create_pg_cluster.sh
    bash /app/pldotnet/Dockerfiles/scripts/start_pg_cluster.sh
    bash /app/pldotnet/Dockerfiles/scripts/install_make.sh
    service postgresql stop
    rsync -a ${PGDATA}/* /var/lib/postgresql/pgnet_backup_cluster

# these targets correspond to the original Dockerfiles which this Makefile replaces
deb_build: install_pg_dev install_dotnet
deb_install: install_pg_dev install_dotnet
ubuntu18_install: install_pg_dev install_dotnet
ubuntu20_install: install_pg_dev install_dotnet
ubuntu21_install: install_pg_dev install_dotnet


